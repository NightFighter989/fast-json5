{
  "name": "fast-json5",
  "version": "0.1.0",
  "description": "Fast JSON5 parser: rewrites JSON5 to JSON with a native regex fast path, then lets JSON.parse build the values",
  "keywords": [
    "json5",
    "json",
    "jsonc",
    "parse",
    "parser",
    "config",
    "fast",
    "performance",
    "comments"
  ],
  "homepage": "https://github.com/OWNER/fast-json5#readme",
  "bugs": {
    "url": "https://github.com/OWNER/fast-json5/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/fast-json5.git"
  },
  "license": "MIT",
  "author": "Thomas Sedman",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "bench": "node bench/index.js",
    "bench:ab": "node bench/ab.js",
    "size": "node scripts/size.mjs",
    "lint:pkg": "publint && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run test:smoke && npm run lint:pkg",
    "test:fuzz": "vitest run test/fuzz.test.ts --mode fuzz",
    "test:update-known": "vitest run test/conformance.test.ts --mode update-known",
    "test:smoke": "node test/smoke/smoke.mjs && node test/smoke/smoke.cjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.5",
    "confbox": "^0.3.1",
    "fast-check": "^4.10.2",
    "json5": "^2.2.3",
    "jsonc-parser": "^3.3.1",
    "mitata": "^1.0.34",
    "publint": "^0.3.25",
    "rolldown": "^1.2.14",
    "strip-json-comments": "^5.0.3",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
